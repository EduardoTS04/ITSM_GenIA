# Copy to .env and edit as needed. Every value below is the built-in default,
# so an empty .env behaves exactly like no .env at all.
# See app/core/config.py for the Settings definitions.

# SQLAlchemy connection string; docker-compose overrides this with an absolute path.
DATABASE_URL=sqlite:///./data/itsm.db

# Base URL of the Ollama server; use http://host.docker.internal:11434 from a container.
OLLAMA_BASE_URL=http://localhost:11434

# Model tag the 4-agent pipeline requests from Ollama.
OLLAMA_MODEL=llama3.2

# Timeout in seconds for a single Ollama call (there are 4 per ticket).
OLLAMA_TIMEOUT_SECONDS=60.0

# Retries after the first attempt; only for timeouts and connection errors.
OLLAMA_MAX_RETRIES=2

# First retry delay in seconds; doubles on each subsequent retry.
OLLAMA_RETRY_BACKOFF_SECONDS=0.5

# Origins allowed by CORS; comma-separated list. Cannot contain '*' when allow_credentials is True.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging verbosity (DEBUG, INFO, WARNING, ERROR); reserved, not yet wired into logging.
LOG_LEVEL=INFO

# Deployment environment name (development, staging, production).
APP_ENV=development

# Dev-only: build missing tables from the ORM models at startup instead of running
# `alembic upgrade head`. Leave false outside throwaway databases.
AUTO_CREATE_SCHEMA=false
