    e.preventDefault();
    setSubmitting(true);
    setError(null);

    try {
      await axios.post(`${API_URL}/api/v1/tickets/${ticketId}/escalate`);
      setSuccess(true);
      if (onEscalated) {
        onEscalated();
      }
