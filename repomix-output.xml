name: backend-tests

# A failing job here reports a failed check on the pull request. To actually
# block merges, enable branch protection for the default branch and mark the
# "pytest" job below as a required status check (configured in repo settings,
# not in this file).
#
# GitHub only runs workflows found in .github/workflows at the *repository*
# root. If this project is a subdirectory of the repo, move this file there and
# change working-directory below to "<project>/backend".

on:
  push:
    branches: ["**"]
  pull_request:

jobs:
  pytest:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: backend

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip
          cache-dependency-path: |
            backend/requirements.txt
            backend/requirements-dev.txt

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt -r requirements-dev.txt

      - name: Run tests
        # The suite mocks every Ollama call, so no LLM service is needed here.
        run: pytest --cov=app --cov-report=term-missing
