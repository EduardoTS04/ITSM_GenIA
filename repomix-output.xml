            </button>
          </div>
        </div>
      )}

      {/* ── Status Info (Results count) ── */}
      {!loading && !error && (
        <div style={{ marginBottom: '1rem', color: theme.colors.textMuted, fontSize: '0.9rem', fontWeight: 500 }}>
