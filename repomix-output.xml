              <a
                href="tel:+56912345678"
                onClick={(e) => {
                  e.preventDefault();
                  alert('Llamando a soporte al +56 9 1234 5678 (Demo)...');
                }}
                style={{
                  display: 'flex',
                  flexDirection: 'column',
                  alignItems: 'center',
                  padding: '1rem',
